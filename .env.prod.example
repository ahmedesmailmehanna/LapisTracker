# Copy to .env.prod and fill in. .env.prod is git-ignored: never commit it.

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
# Host names or IPs the site is reached at, comma-separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to 0 after creating your account to stop new sign-ups.
DJANGO_ALLOW_REGISTRATION=1
# Only once the site is served over HTTPS:
# DJANGO_HTTPS=1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tracker.example.com

# --- Database ---
# With the "localdb" profile the host is "db"; on AWS it is the RDS endpoint.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=lapistracker
POSTGRES_USER=lapistracker
POSTGRES_PASSWORD=change-me
